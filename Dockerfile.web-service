FROM centos:7

# Install EPEL repo manually
RUN curl -o /tmp/epel-release-latest-7.noarch.rpm https://dl.fedoraproject.org/pub/epel/epel-release-latest-7.noarch.rpm && \
    rpm -ivh /tmp/epel-release-latest-7.noarch.rpm && \
    yum clean all

# Install yum-utils and basic dependencies
RUN yum install -y yum-utils wget curl \
    && yum clean all

# Install font and X11 dependencies
RUN yum install -y fontconfig dejavu-sans-fonts libXcomposite libXcursor \
    libXdamage libXrandr alsa-lib gtk3 ipa-gothic-fonts \
    xorg-x11-fonts-Type1 xorg-x11-fonts-misc xorg-x11-fonts-75dpi \
    xorg-x11-fonts-100dpi xorg-x11-utils \
    && yum clean all

# Install chromium and other necessary dependencies
RUN yum install -y chromium chromium-headless tzdata \
    && yum clean all

# Install Zabbix Web Service (ensure correct version)
RUN wget https://repo.zabbix.com/zabbix/7.2/rhel/7/x86_64/zabbix-release-7.2-1.el7.noarch.rpm \
    && rpm -ivh zabbix-release-7.2-1.el7.noarch.rpm \
    && yum install -y zabbix-web-service-7.2.6 \
    && yum clean all

# Set environment variables for Chromium and Zabbix Web Service
ENV CHROME_BIN=/usr/bin/chromium
ENV ZBX_WEB_SERVICE_PORT=10053
ENV ZBX_WEB_SERVICE_CONFIG="/etc/zabbix/zabbix_web_service.conf"

# Run Zabbix web service as the default command
CMD ["zabbix_web_service"]
