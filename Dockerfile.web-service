FROM zabbix/zabbix-web-service:alpine-7.2.6

USER root

# Add community repository for Chromium, and update package lists
RUN sed -i '/^#.*community/s/^#//' /etc/apk/repositories && \
    apk update && \
    apk add --no-cache \
        chromium \
        nss \
        freetype \
        harfbuzz \
        ttf-freefont \
        dumb-init \
    && mkdir -p /var/cache/chromium/crashpad/database \
    && chown -R zabbix:zabbix /var/cache/chromium/crashpad

# Set Chromium path for Zabbix
ENV CHROMIUM_BIN="/usr/bin/chromium-browser"
ENV CHROME_CRASHPAD_DIR="/var/cache/chromium/crashpad"
ENV CHROME_CRASHPAD_DATABASE="/var/cache/chromium/crashpad/database"
ENV CHROMIUM_FLAGS="--enable-logging --v=1"

# Verify installation
RUN chromium-browser --version

USER zabbix
